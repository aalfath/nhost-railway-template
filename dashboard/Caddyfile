{
	admin off
	auto_https off
	persist_config off
}

:{$PORT} {
	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	@protected not path /healthz
	basic_auth @protected {
		{$DASHBOARD_USERNAME} {$DASHBOARD_PASSWORD_HASH}
	}

	handle /apis/* {
		reverse_proxy {$HASURA_CLI_UPSTREAM}
	}

	handle {
		reverse_proxy {$DASHBOARD_UPSTREAM}
	}
}
